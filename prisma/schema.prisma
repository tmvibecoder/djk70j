// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Benutzer (Login)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  role         String   @default("admin") // admin, orga
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesEntries SalesEntry[]
}

// Produkte (Getränke & Speisen)
model Product {
  id             String   @id @default(cuid())
  name           String
  purchasePrice  Float // Einkaufspreis
  salePrice      Float // Verkaufspreis
  unit           String // z.B. "Flasche", "Kiste", "Stück"
  category       String // z.B. "Bier", "Softdrinks", "Wein", "Speisen"
  isActive       Boolean  @default(true)
  // Warenwirtschaft: Trennung Katalog (Verkaufsware) vs. Inventur (eingekaufte Ware)
  trackInventory Boolean  @default(false) // true = erscheint in der Inventur statt im Katalog
  packSize       Int      @default(0) // Gebindegröße (z.B. 12 = Träger à 12); 0 = Einzelware
  packLabel      String? // Bezeichnung des Gebindes, z.B. "Träger"
  isCritical     Boolean  @default(false) // kritisches Getränk → in der Inventur hervorgehoben, häufiger zählen
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventories     Inventory[]
  salesEstimates  SalesEstimate[]
  salesEntries    SalesEntry[]
  forecastEntries ForecastEntry[]
}

// Verkaufs-Eintragungen (protokolliert mit Zeitstempel und Benutzer)
model SalesEntry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int // Verkaufte Menge in dieser Eintragung
  eventDay  String // "thursday", "friday", "saturday", "sunday"
  enteredBy String? // User ID oder Name des Erfassers
  user      User?    @relation(fields: [enteredBy], references: [id], onDelete: SetNull)
  notes     String? // Optionale Notiz
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([eventDay])
}

// Inventur-Einträge
model Inventory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float // Gesamtmenge in Flaschen/Stück (= packs * packSize + loose)
  packs     Float? // gezählte volle Gebinde (Träger), optional
  loose     Float? // gezählte lose Einzelflaschen, optional
  session   String? // Zählzeitpunkt-Key (z.B. "freitag", "samstag_spaet"); siehe COUNT_SESSIONS
  date      DateTime @default(now())
  eventDay  String // "thursday", "friday", "saturday", "sunday"
  type      String // "start", "end", "delivery", "count"
  notes     String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([eventDay])
  @@index([session])
}

// Verkaufsschätzungen
model SalesEstimate {
  id                String  @id @default(cuid())
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventDay          String
  estimatedQuantity Float

  @@unique([productId, eventDay])
}

// Teams (für Watt-Turnier)
model Team {
  id       String @id @default(cuid())
  name     String
  eventDay String @default("thursday")

  participants Participant[]
}

// Teilnehmer
model Participant {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  eventDay  String   @default("thursday")
  paid      Boolean  @default(false)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([eventDay])
}

// Aufgaben
model Task {
  id          String    @id @default(cuid())
  eventId     String    @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  title       String
  description String?
  detail      String?
  bereichId   String?
  bereich     Bereich?  @relation(fields: [bereichId], references: [id], onDelete: SetNull)
  deadline    DateTime?
  status      String    @default("offen") // "offen", "in_arbeit", "erledigt"
  eventDay    String?
  category    String?
  priority    String    @default("medium") // "low", "medium", "high"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments TaskAssignment[]

  @@index([bereichId])
  @@index([status])
  @@index([eventDay])
  @@index([eventId])
}

// ─── Protokolle ──────────────────────────────────────────────────────────────

// Bereiche aus den Sitzungs-Protokollen (Musik, Getränke, Zelt, …)
model Bereich {
  id              String   @id @default(cuid())
  eventId         String   @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  name            String
  icon            String // emoji
  verantwortliche String // Freitext, z.B. "Hundi, Mäx, Festausschuss"
  ordering        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks       Task[]
  beschluesse Beschluss[]

  @@index([eventId])
}

// Personen (Festausschuss-Mitglieder), separat von User für mögliches späteres Login
model Person {
  id         String   @id @default(cuid())
  eventId    String   @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  name       String
  initials   String
  color      String // hex
  ordering   Int      @default(0)
  isCatchAll Boolean  @default(false) // true für "Helfer x"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments TaskAssignment[]

  @@index([eventId])
}

// M:N Task ↔ Person
model TaskAssignment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([taskId, personId])
  @@index([taskId])
  @@index([personId])
}

// Beschlüsse aus den Sitzungs-Protokollen
model Beschluss {
  id        String   @id @default(cuid())
  text      String
  bereichId String
  bereich   Bereich  @relation(fields: [bereichId], references: [id], onDelete: Cascade)
  ordering  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([bereichId])
}

// ─── Finanzen ────────────────────────────────────────────────────────────────

// Kostenpositionen (Zeltmiete, Band, Security, etc.)
model CostItem {
  id          String   @id @default(cuid())
  eventId     String   @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  name        String
  projected   Float    @default(0) // Brutto-Betrag; Netto/MwSt werden über vatRate abgeleitet
  actual      Float?
  vatRate     Float    @default(0) // MwSt-Satz in %: 0, 7 oder 19
  amountEntry String   @default("brutto") // "netto" | "brutto" – wie der Betrag zuletzt eingegeben wurde
  dueDate     String   @default("before") // "before", "during", "after", "paid"
  costType    String   @default("fix") // "fix", "variabel_getraenke", "variabel_sonstig", "unklar"
  status      String   @default("offen") // "fix", "bezahlt", "zugesagt", "geplant", "geschaetzt", "offen", "klaeren", "bestellen", "anfragen"
  eventDay    String? // "thursday", "friday", "saturday", "sunday", null = Allgemein
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

// Anmerkungen von Besuchern zum Abschlussbericht (TOP-Punkt + optionaler Unterpunkt)
model BerichtAnmerkung {
  id         String   @id @default(cuid())
  eventId    String   @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  name       String // wer die Anmerkung formuliert hat
  top        String // z.B. "top3"
  unterpunkt String? // z.B. "3.4 · Infrastruktur & Abläufe", null = ganzer TOP
  text       String
  createdAt  DateTime @default(now())

  @@index([eventId])
}

// Sponsoren & Zuschüsse
model Sponsor {
  id        String   @id @default(cuid())
  eventId   String   @default("jubilaeum-2026") // Veranstaltung (src/data/veranstaltungen.ts)
  name      String
  amount    Float    @default(0)
  received  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// Vereinfachte Prognose (Besucher × Umsatz/Person)
model SimpleForecast {
  id               String @id @default(cuid())
  eventDay         String // "thursday", "friday", "saturday_day", "saturday_night", "sunday"
  scenario         String // "pessimistic", "realistic", "optimistic"
  visitors         Int    @default(0)
  revenuePerPerson Float  @default(0)
  entryFee         Float  @default(0)
  costPercent      Float  @default(25)

  @@unique([eventDay, scenario])
}

// Prognose-Szenarien (pro Produkt, pro Tag, pro Szenario) — Legacy
model ForecastEntry {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventDay  String // "thursday", "friday", "saturday", "sunday"
  scenario  String // "pessimistic", "realistic", "optimistic"
  quantity  Float   @default(0)

  @@unique([productId, eventDay, scenario])
  @@index([eventDay])
  @@index([scenario])
}

// Eintrittsprognose pro Tag und Szenario
model EntryForecast {
  id       String @id @default(cuid())
  eventDay String // "thursday", "friday", "saturday", "sunday"
  scenario String // "pessimistic", "realistic", "optimistic"
  visitors Int    @default(0)
  entryFee Float  @default(0)

  @@unique([eventDay, scenario])
}

// ─── Werbebanden (dauerhafter Bereich /werbebanden, unabhängig von Veranstaltungen) ───

// Werbepartner (Mieter einer Werbebande am Sportplatz)
model Werbepartner {
  id                      String    @id @default(cuid())
  firma                   String
  ansprechpartner         String? // allgemeiner Kontakt (aus der Excel-Spalte "Name")
  ansprechpartnerBande    String? // Ansprechpartner für die Werbebande selbst
  ansprechpartnerRechnung String? // Ansprechpartner für die Rechnung
  strasse                 String?
  plz                     String?
  ort                     String?
  telefon                 String?
  email                   String?
  istLaenge               Float     @default(0) // tatsächliche Länge der Bande in m
  berechneteLaenge        Float     @default(0) // abgerechnete lfd. Meter (kann von Ist abweichen)
  preisProMeter           Float     @default(40) // netto; 0 = Gratisbande (z.B. DJK-Logo, Fanclub)
  vertragsbeginn          DateTime?
  bandeErneuert           Int? // Jahr der letzten Bandenerneuerung
  rechnungsversand        String    @default("post") // "post" | "uebergabe" | "email"
  abschnitt               Int? // 1..3 = Platzabschnitte, 4 = Zusatzfläche 17,5 m
  positionNr              Int? // Reihenfolge innerhalb des Abschnitts
  kuendigungZum           DateTime? // "Kündigung zum"
  status                  String    @default("aktiv") // "aktiv" | "gekuendigt"
  bemerkung               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  dateien    WerbepartnerDatei[]
  rechnungen WerbebandenRechnung[]

  @@index([status])
}

// Hochgeladene Dateien je Partner (Bandenfoto, unterschriebener Vertrag, Kündigungsschreiben)
model WerbepartnerDatei {
  id        String       @id @default(cuid())
  partnerId String
  partner   Werbepartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  art       String // "foto" | "vertrag" | "kuendigung"
  dateiname String // Original-Dateiname
  pfad      String // Pfad relativ zu uploads/werbebanden/
  mimeType  String
  groesse   Int // Bytes
  createdAt DateTime     @default(now())

  @@index([partnerId])
}

// Jahresrechnung — Snapshot der Partnerdaten zum Rechnungszeitpunkt,
// nachträglich frei editierbar (bewusste Entscheidung des Nutzers)
model WerbebandenRechnung {
  id               String        @id @default(cuid())
  partnerId        String?
  partner          Werbepartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  saison           String // z.B. "2025/2026"
  jahr             Int // Nummernkreis-Jahr, z.B. 2026
  laufnummer       Int // 1, 2, … (je Jahr fortlaufend)
  nummer           String        @unique // z.B. "2026/B/0001"
  datum            DateTime      @default(now())
  firma            String
  ansprechpartner  String?
  strasse          String?
  plz              String?
  ort              String?
  laenge           Float         @default(0) // abgerechnete lfd. Meter
  preisProMeter    Float         @default(0)
  netto            Float         @default(0)
  mwstSatz         Float         @default(19)
  mwst             Float         @default(0)
  brutto           Float         @default(0)
  zahlungszielTage Int           @default(14)
  status           String        @default("erstellt") // "erstellt" | "versendet" | "bezahlt"
  bemerkung        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([jahr, laufnummer])
  @@index([saison])
  @@index([partnerId])
}

// DJK-Stammdaten für Rechnungen + Bereichs-Passwort (Singleton, id "werbebanden")
model WerbebandenEinstellung {
  id                    String   @id @default("werbebanden")
  vereinsname           String   @default("DJK SG Ottenhofen e.V.")
  kassierName           String   @default("")
  absenderzeile         String   @default("") // kleine Absenderzeile über dem Adressfeld
  bankName              String   @default("")
  iban                  String   @default("")
  bic                   String   @default("")
  zahlungszielTage      Int      @default(14)
  standardPreisProMeter Float    @default(40)
  mwstSatz              Float    @default(19)
  passwordHash          String   @default("") // bcrypt-Hash des Bereichs-Passworts
  // Briefkopf/Fußzeile der Rechnungs-PDF (mehrzeilig, editierbar — Inhalte
  // aus der offiziellen Briefvorlage; Logos liegen in src/lib/rechnung-assets.ts)
  kopfKontaktblock      String   @default("") // rechts oben (Kassier, Mobil, E-Mail)
  fusszeileSpalte1      String   @default("") // Anschrift/Kontakt
  fusszeileSpalte2      String   @default("") // Register/Steuer/Vorsitzender
  fusszeileSpalte3      String   @default("") // Bankverbindungen
  updatedAt             DateTime @updatedAt
}

// ─── Schlüsselverwaltung (dauerhafter Bereich /schluessel, unabhängig von Veranstaltungen) ───

// Schlüsseltyp: eine Schließung/Sorte, z.B. GHS, GS1, Einzelschlüssel 4,
// Transponder Halle, Schrankschloss SY0005, Briefkasten
model SchluesselTyp {
  id          String  @id @default(cuid())
  system      String // "abus" | "transponder" | "schrank" | "sonstige"
  code        String // "GHS", "GS1".."GS6", "1".."27", "SY0005", "briefkasten", …
  bezeichnung String  @default("")
  kategorie   String  @default("") // ABUS: "general" | "gruppe" | "einzel"
  sortier     Int     @default(0)
  bemerkung   String?

  exemplare     SchluesselExemplar[]
  planEintraege SchluesselSchliessplanEintrag[]

  @@unique([system, code])
  @@index([system])
}

// Physisches Exemplar (Kopie) eines Typs. Bestand = groupBy(status),
// keine redundanten Zähler. ABUS-Kopien sind anonym (keine Prägenummer) —
// bei der Rückgabe wird deshalb einfach „irgendeine" Kopie zurückgebucht.
model SchluesselExemplar {
  id          String        @id @default(cuid())
  typId       String
  typ         SchluesselTyp @relation(fields: [typId], references: [id], onDelete: Cascade)
  nummer      String? // Transponder-Nr. (20–73) bzw. Prägenummer, sonst null
  status      String        @default("archiv") // "archiv" | "ausgegeben" | "keygarage" | "verloren" | "gesperrt"
  lagerDetail String? // z.B. Keygarage-Gruppe
  bemerkung   String?
  createdAt   DateTime      @default(now())

  ausgaben SchluesselAusgabe[]

  @@index([typId, status])
}

// Tür/Schließzylinder der ABUS-Anlage (Zeile der Schließmatrix)
model SchluesselTuer {
  id      String  @id @default(cuid())
  name    String
  nummer  String? // Nummer des zugehörigen Einzelschlüssels
  sortier Int     @default(0)

  planEintraege SchluesselSchliessplanEintrag[]
}

// Schließmatrix: Eintrag = dieser Typ sperrt diese Tür
model SchluesselSchliessplanEintrag {
  id     String         @id @default(cuid())
  tuerId String
  tuer   SchluesselTuer @relation(fields: [tuerId], references: [id], onDelete: Cascade)
  typId  String
  typ    SchluesselTyp  @relation(fields: [typId], references: [id], onDelete: Cascade)

  @@unique([tuerId, typId])
}

// Schlüsselinhaber — bewusst eigene Liste, getrennt vom Event-Modell Person
// (Privatadressen, dauerhafte Daten)
model SchluesselPerson {
  id        String   @id @default(cuid())
  name      String
  bereich   String   @default("") // "Vorstand" | "Trainer" | "Pächter" | …
  funktion  String   @default("")
  adresse   String   @default("")
  telefon   String   @default("")
  email     String   @default("")
  bemerkung String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ausgaben SchluesselAusgabe[]
  belege   SchluesselBeleg[]

  @@index([name])
}

// Empfangs-/Rückgabebestätigung: bündelt mehrere Ausgaben gegen EINE
// Unterschrift. payloadJson ist der kanonische signierte String; hash =
// SHA256(payloadJson + "\n" + SHA256(unterschriftPng) + "\n" + signiertAm-ISO).
model SchluesselBeleg {
  id               String           @id @default(cuid())
  art              String // "ausgabe" | "rueckgabe"
  status           String           @default("offen") // "offen" | "signiert"
  personId         String
  person           SchluesselPerson @relation(fields: [personId], references: [id], onDelete: Restrict)
  payloadJson      String           @default("")
  unterschriftPfad String? // relativ zu uploads/schluessel/
  pdfPfad          String?
  hash             String? // SHA-256 hex
  signiertAm       DateTime?
  signierToken     String? // Vorhalt für spätere öffentliche Sign-Links (v1 ungenutzt)
  createdAt        DateTime         @default(now())

  ausgaben   SchluesselAusgabe[] @relation("AusgabeBeleg")
  rueckgaben SchluesselAusgabe[] @relation("RueckgabeBeleg")

  @@index([personId])
  @@index([status])
}

// Eine Schlüssel-Ausgabe (Exemplar an Person), inkl. späterer Rückgabe
model SchluesselAusgabe {
  id             String             @id @default(cuid())
  exemplarId     String
  exemplar       SchluesselExemplar @relation(fields: [exemplarId], references: [id], onDelete: Restrict)
  personId       String
  person         SchluesselPerson   @relation(fields: [personId], references: [id], onDelete: Restrict)
  ausgabeDatum   DateTime           @default(now())
  rueckgabeDatum DateTime?
  pfandBetrag    Float              @default(0)
  pfandZurueck   Float              @default(0)
  status         String             @default("aktiv") // "aktiv" | "zurueck"
  bemerkung      String?

  ausgabeBelegId   String?
  ausgabeBeleg     SchluesselBeleg? @relation("AusgabeBeleg", fields: [ausgabeBelegId], references: [id], onDelete: SetNull)
  rueckgabeBelegId String?
  rueckgabeBeleg   SchluesselBeleg? @relation("RueckgabeBeleg", fields: [rueckgabeBelegId], references: [id], onDelete: SetNull)

  @@index([personId, status])
  @@index([exemplarId, status])
}

// Journal der Bestandsänderungen (Verlust, Nachlieferung, Korrektur, Statuswechsel)
model SchluesselBestandsAenderung {
  id         String   @id @default(cuid())
  typId      String?
  exemplarId String?
  art        String // "verlust" | "nachlieferung" | "korrektur" | "statuswechsel"
  notiz      String   @default("")
  createdAt  DateTime @default(now())

  @@index([typId])
}

// Pfandkasse: Bestand = Summe aller Buchungen (+ Einzahlung, − Auszahlung)
model SchluesselPfandBuchung {
  id        String   @id @default(cuid())
  betrag    Float
  notiz     String   @default("")
  belegId   String? // Beleg, aus dem die Buchung entstand (optional)
  createdAt DateTime @default(now())
}

// Bereichs-Passwort + Vorgaben (Singleton, id "schluessel")
model SchluesselEinstellung {
  id            String   @id @default("schluessel")
  passwordHash  String   @default("") // bcrypt-Hash des Bereichs-Passworts
  standardPfand Float    @default(20)
  ausgeberName  String   @default("") // Vorbelegung „ausgegeben durch" auf Belegen
  updatedAt     DateTime @updatedAt
}

// ─── DJK Info Broschüre (dauerhafter Bereich /djk-info, unabhängig von Veranstaltungen) ───

// Anzeigenkunde der Vereinszeitschrift
model InfoKunde {
  id                      String    @id @default(cuid())
  firma                   String
  zusatz                  String?   // Namenszusatz (aus der Excel-Spalte "Zusatz")
  strasse                 String?
  plz                     String?
  ort                     String?
  telefon                 String?
  email                   String?
  ansprechpartnerInhaber  String?   // Ansprechpartner DJK Info (Inhaber)
  ansprechpartnerRechnung String?   // Ansprechpartner für die Rechnung
  rechnungEmail           String?   // abweichende E-Mail für den Rechnungsversand
  rechnungsversand        String    @default("post")        // "post" | "persoenlich" | "email"
  broschuerenversand      String    @default("persoenlich") // "post" | "persoenlich" | "email"
  anzeigenGroesse         String    @default("1/2") // Schlüssel in InfoPreis ("1/1".."1/4")
  kuendigungZum           DateTime?
  status                  String    @default("aktiv") // "aktiv" | "gekuendigt"
  bemerkung               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  schaltungen InfoSchaltung[]
  rechnungen  InfoRechnung[]
  dateien     InfoDatei[]

  @@index([status])
}

// Pflegbare Preistabelle (Jahrespreis netto je Anzeigengröße; Preis/Anzeige = Jahrespreis ÷ 3)
model InfoPreis {
  id          String @id @default(cuid())
  groesse     String @unique // "1/1" | "3/4" | "2/3" | "1/2" | "1/3" | "1/4"
  bezeichnung String // z.B. "1 Seite (130 × 180 mm)"
  jahresNetto Float
  sortierung  Int    @default(0)
}

// Eine Ausgabe der Zeitschrift (3 pro Jahr)
model InfoAusgabe {
  id          String    @id @default(cuid())
  jahr        Int
  nummer      Int       // 1..3
  bezeichnung String    @unique // z.B. "2026-1"
  erscheinung DateTime?
  status      String    @default("geplant") // "geplant" | "erschienen"
  auflage     Int       @default(896)
  druckKosten Float?    // eine Druckrechnung je Ausgabe ist der Regelfall
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schaltungen InfoSchaltung[]
  dateien     InfoDatei[]

  @@unique([jahr, nummer])
}

// Anzeige eines Kunden in einer Ausgabe (von Redakteuren gepflegt) —
// Grundlage der anteiligen Jahresabrechnung
model InfoSchaltung {
  id        String      @id @default(cuid())
  kundeId   String
  kunde     InfoKunde   @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  ausgabeId String
  ausgabe   InfoAusgabe @relation(fields: [ausgabeId], references: [id], onDelete: Cascade)
  groesse   String?     // optionaler Override, sonst gilt InfoKunde.anzeigenGroesse
  createdAt DateTime    @default(now())

  @@unique([kundeId, ausgabeId])
  @@index([ausgabeId])
}

// Jahresrechnung — Snapshot der Kundendaten zum Rechnungszeitpunkt,
// nachträglich frei editierbar (gleiches Muster wie WerbebandenRechnung)
model InfoRechnung {
  id               String     @id @default(cuid())
  kundeId          String?
  kunde            InfoKunde? @relation(fields: [kundeId], references: [id], onDelete: SetNull)
  leistungsjahr    Int        // abgerechnetes Jahr (Schaltungen)
  jahr             Int        // Nummernkreis-Jahr
  laufnummer       Int        // 1, 2, … (je Jahr fortlaufend, Kreis "I")
  nummer           String     @unique // z.B. "2026/I/0001"
  datum            DateTime   @default(now())
  firma            String
  zusatz           String?
  ansprechpartner  String?
  strasse          String?
  plz              String?
  ort              String?
  anzeigenGroesse  String     @default("")
  jahresNetto      Float      @default(0) // Jahrespreis netto lt. Preisliste zum Zeitpunkt des Laufs
  anzahlAusgaben   Int        @default(3) // geschaltete Ausgaben (n von 3)
  ausgabenListe    String     @default("") // z.B. "2026-1, 2026-2"
  netto            Float      @default(0) // round(jahresNetto × n ÷ 3, 2)
  mwstSatz         Float      @default(19)
  mwst             Float      @default(0)
  brutto           Float      @default(0)
  zahlungszielTage Int        @default(14)
  status           String     @default("erstellt") // "erstellt" | "versendet" | "bezahlt"
  bemerkung        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([jahr, laufnummer])
  @@index([leistungsjahr])
  @@index([kundeId])
}

// Hochgeladene Dateien — je Kunde (Vertrag, Kündigung, Anzeigenbild)
// oder je Ausgabe (Druckrechnung, Heft-PDF)
model InfoDatei {
  id        String       @id @default(cuid())
  kundeId   String?
  kunde     InfoKunde?   @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  ausgabeId String?
  ausgabe   InfoAusgabe? @relation(fields: [ausgabeId], references: [id], onDelete: Cascade)
  art       String       // Kunde: "vertrag" | "kuendigung" | "anzeige" — Ausgabe: "druckrechnung" | "heft"
  dateiname String       // Original-Dateiname
  pfad      String       // Pfad relativ zu uploads/djk-info/
  mimeType  String
  groesse   Int          // Bytes
  createdAt DateTime     @default(now())

  @@index([kundeId])
  @@index([ausgabeId])
}

// Verteilbereich: Ottenhofener Austragegebiet, Ortsteil, Auslagestelle oder Postversand
model InfoVerteilgebiet {
  id           String   @id @default(cuid())
  name         String
  kategorie    String   @default("gebiet") // "gebiet" | "ortsteil" | "auslage" | "postversand"
  beschreibung String?  // z.B. "Ehrenmitglieder u.a. · z.B. Adolf Fischer"
  hefte        Int      @default(0) // editierbar; wird NICHT aus den Straßen erzwungen
  sortierung   Int      @default(0)
  updatedAt    DateTime @updatedAt

  strassen InfoStrasse[]
}

// Straße innerhalb eines Ottenhofener Austragegebiets (Heftzahl editierbar)
model InfoStrasse {
  id         String            @id @default(cuid())
  gebietId   String
  gebiet     InfoVerteilgebiet @relation(fields: [gebietId], references: [id], onDelete: Cascade)
  name       String
  hefte      Int               @default(0)
  sortierung Int               @default(0)

  @@index([gebietId])
}

// Verteilerliste: wer trägt was aus (Person "" = noch offen)
model InfoVerteiler {
  id             String   @id @default(cuid())
  person         String   @default("")
  zustaendigkeit String
  stueckzahl     Int      @default(0)
  verguetung     String   @default("kostenlos") // "kostenlos" | "verguetet"
  betrag         Float?   // nur bei verguetung = "verguetet"
  sortierung     Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// DJK-Info-Stammdaten + die drei Rollen-Passwörter (Singleton, id "djk-info")
model InfoEinstellung {
  id                       String   @id @default("djk-info")
  vereinsname              String   @default("DJK SG Ottenhofen e.V.")
  kassierName              String   @default("")
  absenderzeile            String   @default("")
  bankName                 String   @default("")
  iban                     String   @default("")
  bic                      String   @default("")
  zahlungszielTage         Int      @default(14)
  mwstSatz                 Float    @default(19)
  ausgabenProJahr          Int      @default(3)
  druckereiName            String   @default("")
  druckereiAnsprechpartner String   @default("")
  druckereiTelefon         String   @default("")
  druckereiEmail           String   @default("")
  // Briefkopf/Fußzeile der Rechnungs-PDF (wie WerbebandenEinstellung)
  kopfKontaktblock         String   @default("")
  fusszeileSpalte1         String   @default("")
  fusszeileSpalte2         String   @default("")
  fusszeileSpalte3         String   @default("")
  // bcrypt-Hashes der Rollen-Passwörter (Login-Dropdown)
  passwordHashKassier      String   @default("")
  passwordHashRedakteur    String   @default("")
  passwordHashLeser        String   @default("")
  updatedAt                DateTime @updatedAt
}
